
@model StudentCRUD.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-4">
    <h2>Delete Student</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this student?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Student ID</dt>
        <dd class="col-sm-9">@Model.StudentId</dd>

        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Section</dt>
        <dd class="col-sm-9">@Model.Section</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.EmailId</dd>

        <dt class="col-sm-3">Branch</dt>
        <dd class="col-sm-9">@Model.Branch</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="StudentId" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
